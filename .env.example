# DetectiveAI Environment Configuration Example

# Application Settings
APP_NAME=DetectiveAI
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Server Settings
HOST=127.0.0.1
PORT=8000

# Database Settings
DATABASE_URL=sqlite:///./detective_ai.db

# Lamatic AgentKit Settings
LAMATIC_ENDPOINT=https://your-project.lamatic.ai/api/graphql
LAMATIC_PROJECT_ID=your-project-id
LAMATIC_API_KEY=your-api-key
LAMATIC_FLOW_ID=your-flow-id
LAMATIC_SUSPECT_FLOW_ID=your-suspect-flow-id
LAMATIC_EVIDENCE_FLOW_ID=your-evidence-flow-id
LAMATIC_SOLUTION_FLOW_ID=your-solution-flow-id
