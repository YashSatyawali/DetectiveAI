# DetectiveAI Environment Configuration Example

# Application Settings
APP_NAME=DetectiveAI
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Server Settings
HOST=127.0.0.1
PORT=8000

# Database Settings
DATABASE_URL=sqlite:///./detective_ai.db

# Lamatic AgentKit Settings
LAMATIC_ENDPOINT=https://your-project.lamatic.ai/api/graphql    #The endpoint might be very different. Find it in the api docs button.
LAMATIC_PROJECT_ID=your-project-id
LAMATIC_API_KEY=your-api-key
LAMATIC_FLOW_ID=your-flow-id  #this is  just a placeholder not necessary to fill it. leave empty for this project.
LAMATIC_SUSPECT_FLOW_ID=your-suspect-flow-id    # depending on the flow add the id. this is only for the suspect/interrogation but not for the other flows.
LAMATIC_EVIDENCE_FLOW_ID=your-evidence-flow-id  # same goes for this also. 
LAMATIC_SOLUTION_FLOW_ID=your-solution-flow-id 
